<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs scripts/reinstall-iphone.sh every Sunday at 10:00. Install: see README "Weekly reinstall". -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.lohith.dissolve.reinstall</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-lc</string>
		<string>"$HOME/dissolve/scripts/reinstall-iphone.sh"</string>
	</array>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>0</integer>
		<key>Hour</key>
		<integer>10</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>StandardOutPath</key>
	<string>/tmp/dissolve-reinstall.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/dissolve-reinstall.log</string>
</dict>
</plist>
